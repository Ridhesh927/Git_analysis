# GitHub Analyzer — Backend Environment Variables
# Copy this file to .env (or set these vars in your IDE run config / shell).
# NEVER commit .env to Git.

# ── GitHub Personal Access Token ──────────────────────────────────────────────
# How to get one:
# 1. Go to https://github.com/settings/tokens
# 2. Click "Generate new token (classic)"
# 3. Name it "github-analyzer", set expiry, check "public_repo" scope
# 4. Copy the token immediately (shown only once) and paste below:
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# ── Neon DB (Serverless PostgreSQL) ───────────────────────────────────────────
# How to get your connection string:
# 1. Sign up / log in at https://console.neon.tech
# 2. Create a project → "Connection Details" → switch to "JDBC" format
# 3. The URL already includes your username & password, e.g.:
#    jdbc:postgresql://ep-xxx.us-east-2.aws.neon.tech/neondb?user=neondb_owner&password=abc123&sslmode=require
# 4. Copy it exactly as-is and paste below — no separate user/password needed!
NEON_DATABASE_URL=jdbc:postgresql://YOUR_HOST/YOUR_DB?user=YOUR_USER&password=YOUR_PASSWORD&sslmode=require

# ── How to load these in different environments ────────────────────────────────
# IntelliJ IDEA:
#   Run → Edit Configurations → Environment Variables → paste each KEY=VALUE
#
# VS Code (with "EnvFile" extension):
#   In launch.json: "envFile": "${workspaceFolder}/backend/.env"
#
# PowerShell (manual):
#   $env:GITHUB_TOKEN="ghp_xxx"
#   $env:NEON_DATABASE_URL="jdbc:postgresql://..."
#   mvn spring-boot:run
#
# Bash / WSL:
#   export GITHUB_TOKEN=ghp_xxx
#   export NEON_DATABASE_URL=jdbc:postgresql://...
#   mvn spring-boot:run
